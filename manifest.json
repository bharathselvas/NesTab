{
  "manifest_version": 3,
  "name": "NesTAb",
  "version": "1.0",
  "description": "Save, manage and restore your browser tab sessions",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NesTAb",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "tabs"
  ]
}
